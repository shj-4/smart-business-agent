# انسخ هذا الملف إلى .env وعبّئ القيم (لا تُرسل .env إلى git)

# إلزامي
TELEGRAM_BOT_TOKEN=
GEMINI_API_KEY=

# توصية أمنية — مفتاح base64 بـ 32 بايت (يفضَّل توليده: openssl rand -base64 32)
ENCRYPTION_KEY=

# اختياري
DATABASE_URL=
TIMEZONE=Asia/Gaza
FIRST_DAY_OF_WEEK=6
BASE_CURRENCY=ILS
REPORT_TIME=19:00
APP_ENV=development
LOG_FORMAT=text
ADMIN_USER_IDS=
SENTRY_DSN=
CACHE_TTL_SECONDS=60
AI_QUEUE_ENABLED=false
AI_QUEUE_MAXSIZE=64
AI_QUEUE_CONCURRENCY=2
MAX_VOICE_FILE_MB=20

# لوحة التحكم وواجهات /api/* — مصادقة Basic إلزامية.
# إن تُرك DASHBOARD_PASSWORD فارغًا، تُولَّد كلمة مرور مؤقتة عند كل إقلاع وتُطبع في سجل التشغيل.
DASHBOARD_USERNAME=admin
DASHBOARD_PASSWORD=